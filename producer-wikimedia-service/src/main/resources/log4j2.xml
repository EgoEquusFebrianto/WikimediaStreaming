<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- Rolling File Appender -->
        <RollingFile name="RollingFile" fileName="logs/producer/producer-event-logs.log"
                     filePattern="logs/app-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n</Pattern>
            </PatternLayout>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="1"/>
        </RollingFile>

        <RollingFile name="MetricsFile" fileName="logs/producer/producer-metrics-logs.log"
                     filePattern="logs/app-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout>
                <Pattern>%msg%n</Pattern>
            </PatternLayout>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="1"/>
        </RollingFile>

<!--        &lt;!&ndash; Kafka Appender &ndash;&gt;-->
<!--        <RollingFile name="KafkaSystem" fileName="logs/producer/kafka-producer-system.log"-->
<!--                     filePattern="logs/kafka-%d{yyyy-MM-dd}.log.gz">-->
<!--            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>-->
<!--            <Policies>-->
<!--                <SizeBasedTriggeringPolicy size="10MB"/>-->
<!--            </Policies>-->
<!--            <DefaultRolloverStrategy max="3"/>-->
<!--        </RollingFile>-->
    </Appenders>

    <Loggers>
<!--        <Logger name="org.apache.kafka" level="info" additivity="false">-->
<!--            <AppenderRef ref="KafkaSystem"/>-->
<!--        </Logger>-->

<!--        <Logger name="org.apache.zookeeper" level="error" additivity="false"/>-->

<!--         Logger Utama -->
        <Logger name="metricsLogger" level="info" additivity="false">
            <AppenderRef ref="MetricsFile"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
<!--            <AppenderRef ref="KafkaSystem"/>-->
        </Root>
    </Loggers>
</Configuration>
